# JNS Video Production - Environment Configuration Template
# Copy this file to .env.local and update with your credentials

# SMTP Dispatcher Configuration (Gmail / Google Workspace App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=production@jns.org
SMTP_PASS=your_app_password_here
SMTP_FROM="JNS Video Production" <production@jns.org>

# Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
