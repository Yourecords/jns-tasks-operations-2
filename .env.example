# ==========================================
# JNS Task Operations Environment Variables
# ==========================================

# Base URL of application (Railway assigns e.g. https://your-app.up.railway.app)
NEXT_PUBLIC_APP_URL=https://tasks.jns.org

# PostgreSQL Database (Provided automatically by Railway PostgreSQL plugin)
DATABASE_URL=postgresql://user:password@host:port/railway

# NextAuth / Auth.js Configuration
# Generate a random 32-byte secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secure-random-nextauth-secret-string
NEXTAUTH_URL=https://tasks.jns.org

# Google Workspace OAuth Credentials (GCP Console -> APIs & Services -> OAuth Credentials)
# Authorized redirect URI: https://tasks.jns.org/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email Dispatcher Configuration (Google Workspace App Password for production@jns.org)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=production@jns.org
SMTP_PASS=your-google-workspace-app-password
SMTP_FROM="JNS Video Production" <production@jns.org>

# Production Email Dispatch Guard: Set to 'true' to allow sending emails in production
ENABLE_EMAIL_DISPATCH=false

# Production Administration Reset Secret (Optional for protected database maintenance)
ADMIN_RESET_SECRET=your-admin-maintenance-secret
